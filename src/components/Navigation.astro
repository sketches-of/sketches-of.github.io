---
import '../styles/global.css'
---
<style>
    .navbar {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: clamp(10px, 7vw, 80px);;
    }

    .nav-item {
        display: block;
        padding: 5px 5px;
        text-decoration: none;
    }

    @media (max-width: 600px) {
    .navbar {
        flex-direction: column;
        gap: 10px;
    }
}
</style>

<nav class="navbar">
    <a class="nav-item" href="/">Home</a>
    <a class="nav-item" href="/gigs">Gigs</a>
    <a class="nav-item" href="/media">Media</a>
    <a class="nav-item" href="/booking">Book Us</a>
    <a class="nav-item" href="/newsletter">Newsletter</a>
</nav>