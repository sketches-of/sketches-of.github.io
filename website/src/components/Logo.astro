---
import '../styles/global.css'
import logo from '../assets/sketches_logo.png'
import { Image } from 'astro:assets';
---
<style>
    .logo-box {
        width: 100%;
        text-align: center;
    }

    .logo {
        width: min(90%, 500px);
        height: auto;
        margin: 0 auto;
    }
</style>

<div class="logo-box">
    <Image class="logo" src={logo} alt="Sketches" />
</div>
