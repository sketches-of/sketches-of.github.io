---
import '../styles/global.css'
---
<style>
    .navbar {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: clamp(3px, 5vw, 80px);
        padding-left: 5px;
        padding-right: 5px;
    }

    .nav-item {
        display: block;
        text-decoration: none;
    }

    @media (max-width: 560px) {
        .nav-item {
            font-size: 16px;
        }
    }

    @media (max-width: 500px) {
        .nav-item {
            font-size: 14px;
        }
    }

    @media (max-width: 380px) {
        .navbar {
            flex-direction: column;
            gap: 10px;
        }
    }

}
</style>

<nav class="navbar">
    <a class="nav-item" href="/">Home</a>
    <a class="nav-item" href="/gigs">Gigs</a>
    <a class="nav-item" href="/media">Media</a>
    <a class="nav-item" href="/booking">Book Us</a>
    <a class="nav-item" href="/newsletter">Newsletter</a>
</nav>